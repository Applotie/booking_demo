# Copy to .env (local) or set in your hosting provider's environment settings.
# Never commit real values.

# Required: MongoDB Atlas connection string (Atlas > Connect > Drivers).
MONGO_URI=

# Optional: database name (default: bus-booking).
MONGODB_DB=

# Required in production: the username and password for the /admin sign-in page.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: secret used to sign admin session cookies (default: derived from the
# admin username and password). Changing it signs everyone out.
ADMIN_SESSION_SECRET=

# Optional: time zone used for trip times on the server (default: Asia/Kolkata).
APP_TIMEZONE=
